# Exclude credentials, runtime/build artifacts and local experiment archives from Git.
.env
.venv/
.agents/
.codex/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local application state. Keep the directory itself in the repository.
data/runtime/*
!data/runtime/.gitkeep

# Local model cache when configured inside the project.
data/model-cache/*
!data/model-cache/.gitkeep

# Keep the extracted demo policies, but not duplicate/source-system artifacts.
data/sampleset_policies.zip
**/.DS_Store
**/__MACOSX/

# The reviewers already have the ADC case document. Do not redistribute it.
project description/

# Local logs and editor settings.
*.log
.idea/
.vscode/

# Local environment variants and interrupted setup files; keep the safe example.
.env.*
!.env.example
*.tmp
*.tmp.*

# Storage files outside the default runtime directory.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Historical development material is preserved locally, outside the submission.
docs/archive/
docs/APEX_LIVE_VALIDATION/
docs/APEX_LIVE_VALIDATION.zip

# Keep reusable question fixtures; exclude generated reports and experiments.
evaluation/*
!evaluation/*_cases.json
!evaluation/retired_case_ids.json
