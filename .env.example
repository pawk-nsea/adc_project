# Example ADC_ settings for local storage and hosted chat; copy to .env for overrides.
ADC_DATABASE_URL=sqlite:///data/runtime/app.db
ADC_VECTOR_STORE_PATH=data/runtime/chroma
ADC_MODEL_CACHE_PATH=data/model-cache
ADC_RETRIEVAL_TOP_K=5
# Required for live /chat calls. Never commit the real value.
ADC_GEMINI_API_KEY=
ADC_CHAT_MODEL=gemini-3.8-flash
ADC_CHAT_THINKING_LEVEL=LOW
ADC_VERIFICATION_MODEL=gemini-3.8-flash
ADC_CHAT_MAX_OUTPUT_TOKENS=4096
ADC_VERIFICATION_MAX_OUTPUT_TOKENS=3072
# Flash 3.8 supports LOW/MEDIUM/HIGH, not MINIMAL.
ADC_VERIFICATION_THINKING_LEVEL=LOW
ADC_CHAT_TEMPERATURE=0.1
ADC_CHAT_TIMEOUT_SECONDS=60
